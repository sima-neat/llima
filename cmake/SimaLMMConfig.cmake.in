@PACKAGE_INIT@

# CMake 3.29 and older let a nested find_dependency() overwrite the
# PACKAGE_PREFIX_DIR created by the package initialization stanza. Develop did
# not notice because
# its unversioned LLiMa runtime also existed in the cross sysroot; the exported
# target could therefore resolve silently to that stale copy instead of the
# exact package named by SimaLMM_DIR.  Preserve our prefix across dependency
# discovery so the target file below always names this package's SONAME-1
# runtime.  CMake 3.30 preserves the variable itself, but keeping this guard is
# harmless and supports the 3.28 builder used for Modalix releases.
set(_SIMA_LMM_PACKAGE_PREFIX_DIR "${PACKAGE_PREFIX_DIR}")
include(CMakeFindDependencyMacro)
find_dependency(fmt CONFIG REQUIRED)
find_dependency(spdlog CONFIG REQUIRED)
set(PACKAGE_PREFIX_DIR "${_SIMA_LMM_PACKAGE_PREFIX_DIR}")
unset(_SIMA_LMM_PACKAGE_PREFIX_DIR)

include("${CMAKE_CURRENT_LIST_DIR}/SimaLMMTargets.cmake")

check_required_components(SimaLMM)
