@PACKAGE_INIT@

set(SimaLMM_DEBIAN_VERSION "@SIMA_LMM_PACKAGE_VERSION@")

# Dependency configs can overwrite PACKAGE_PREFIX_DIR on CMake before 3.30.
set(_SimaLMM_prefix "${PACKAGE_PREFIX_DIR}")
include(CMakeFindDependencyMacro)
find_dependency(fmt CONFIG REQUIRED)
find_dependency(spdlog CONFIG REQUIRED)

set(PACKAGE_PREFIX_DIR "${_SimaLMM_prefix}")
unset(_SimaLMM_prefix)
include("${CMAKE_CURRENT_LIST_DIR}/SimaLMMTargets.cmake")

check_required_components(SimaLMM)
